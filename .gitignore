# ---------------------------------------------------------------------------
# T113 / IVSBox 工程仓库根忽略规则
# ---------------------------------------------------------------------------

# 构建产物（ivsbox-v5/.gitignore 亦有局部规则）
build/
*.o
*.a
*.so
*.exe
compile_commands.json

# 本机验证日志与临时输出
*.log
_*.txt

# 编辑器 / 工具缓存目录
.history/
.arts/
.cache/
.vscode/
.idea/
*.swp

# 工具生成的状态文件
.merkle-snapshot.json

# 临时截图
ScreenShot_*.png

# 打包产物
*.ipk
*.tar.gz
