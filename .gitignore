# ---------------------------------------------------------------------------
# T113 / IVSBox 工程仓库根忽略规则
# ---------------------------------------------------------------------------

# 构建产物（ivsbox/.gitignore 亦有局部规则）
build/
*.o
*.a
*.so
*.exe
compile_commands.json

# 本机验证日志与临时输出
*.log
_*.txt

# 编辑器 / 工具缓存目录
.history/
.arts/
.cache/
.vscode/
.idea/
*.swp

# AI 助手本地工作目录（不进仓库，各 AI 各自维护）
.workbuddy/
.trae/

# git-stint 会话 worktree 目录（会话隔离用，不进仓库）
.stint/

# 工具生成的状态文件
.merkle-snapshot.json
.embeddedskills/

# 临时截图
ScreenShot_*.png

# 打包产物
*.ipk
*.tar.gz
