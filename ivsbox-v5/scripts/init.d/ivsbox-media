#!/bin/sh /etc/rc.common
#
# ivsbox-media -- IVSBox 媒体面进程（架构文档 §4.1、§8）
#
# 资源隔离：本进程是 FFmpeg / RTSP / 存储 / 音频风险的隔离边界，
#           必须由 cgroup 限制 CPU 与内存（架构文档 §14、缺口 G1）。
#
# 崩溃影响：只影响媒体能力，控制与平台业务不受影响，由 procd 单独重启。
# 存储前提：SD 卡未挂载时不得启动录像（由进程内存储巡检判定，不在此脚本判断）。

USE_PROCD=1
START=62
STOP=12

start_service() {
	procd_open_instance
	procd_set_param command /opt/ivsbox/current/bin/ivsbox-media

	procd_set_param user ivsbox
	procd_set_param group ivsbox

	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# TODO(G1): 用 cgroup v2 为 ivsbox-media 设置 memory.max / cpu.weight，
#           数值由 /data 上的实测预算表决定（media.max_channels 与之联动）。
