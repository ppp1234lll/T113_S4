#!/bin/sh /etc/rc.common
#
# ivsbox-web -- IVSBox 管理面进程（架构文档 §4.1、§9、§13.1）
#
# 权限：无特权用户。不访问串口、watchdog、配置密钥，不直接打开控制库或媒体库。
# 依赖：需先由 ivsboxd 创建 IPC socket（START 序号仅保证启动先后，不保证就绪）。

USE_PROCD=1
START=61
STOP=11

start_service() {
	procd_open_instance
	procd_set_param command /opt/ivsbox/current/bin/ivsbox-web

	procd_set_param user ivsbox
	procd_set_param group ivsbox

	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# TODO(G5): ivsboxd 未就绪时的 IPC 重连退避应在进程内实现，不能依赖 START 顺序。
