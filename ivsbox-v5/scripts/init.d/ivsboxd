#!/bin/sh /etc/rc.common
#
# ivsboxd -- IVSBox 主控进程（架构文档 §4.1、§12.3）
#
# 启动顺序：ivsboxd(60) -> ivsbox-web(61) -> ivsbox-media(62)
#   START 序号只解决"先起"的问题，不构成"已就绪"的保证。
#
# 缺口提示（未关闭前不得在实机长期启用）：
#   G2  喂狗判据：健康检查只看主循环进度，慢任务超时不得参与喂狗
#   G5  启动就绪分级 L0~L5 与首次喂狗时机未实现
#   G8  procd 自带的最小熔断已启用（见下），但缺告警与 failsafe 联动
#
# 注意：当前二进制为骨架 stub，会立即退出并触发 respawn。

USE_PROCD=1
START=60
STOP=10

start_service() {
	procd_open_instance
	procd_set_param command /opt/ivsbox/current/bin/ivsboxd

	# respawn 阈值 超时 重试：>5 次 / 5s 则暂停 3600s（procd 自带的最小熔断）
	procd_set_param respawn 3600 5 5

	# TODO(G1): cgroup 限制 CPU/内存尚未配置
	# TODO(G10): core dump 策略（启用开关、存放路径、配额）尚未确定

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
