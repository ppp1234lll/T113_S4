#!/bin/sh
#
# Starts lighttpd.
#
NAME=lighttpd
DAEMON=/usr/sbin/$NAME
PID_FILE="/var/run/$NAME.pid"
CONF_FILE="/etc/$NAME/$NAME.conf"

[ -r /etc/default/$NAME ] && . /etc/default/$NAME

# 2026-10-17：ivsbox-web 部署到 /opt/ivsbox 后由它独占 :80（M5 Web 界面），
# lighttpd 让位 —— 否则两者抢 80，后起者 bind 失败。脚本保留，需要天嵌演示页时
# 手工 `/etc/init.d/S50lighttpd start`（先停 ivsbox-web）即可。
if [ -x /opt/ivsbox/bin/ivsbox-web ]; then
	echo "lighttpd: skipped (ivsbox-web owns :80)"
	exit 0
fi

start() {
	printf "Starting lighttpd: "
	start-stop-daemon -S -q -p $PID_FILE --exec $DAEMON -- -f $CONF_FILE
	echo "OK"
}
stop() {
	printf "Stopping lighttpd: "
	start-stop-daemon -K -q -p $PID_FILE
	echo "OK"
}
restart() {
	stop
	start
}

case "$1" in
  start)
	start
	;;
  stop)
	stop
	;;
  restart|reload)
	restart
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
