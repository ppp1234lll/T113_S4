#!/bin/sh
# IVSBox 主控服务 sysvinit 脚本（M1-S10）
# 不用 procd：板端没有 procd，用 start-stop-daemon 后台拉起。
# 2026-09-30（F1 修正）：start() 只拉起 monitor.sh，**主控由 monitor 唯一拉起**
# （见 monitor.sh 文件头）——init 直启主控会绕过熔断，跨复位 failsafe 被架空。
# 2026-09-30（用户定稿）：**程序放 rootfs 的 /opt/ivsbox，数据留 UDISK**——
# 程序不再随 UDISK 挂载失败（S60mount_udisk 会 mkfs 清空）或整片重刷一起丢。

IVSBOX_USER=${IVSBOX_USER:-root}
IVSBOX_GROUP=${IVSBOX_GROUP:-root}

# 程序（bin/scripts）：rootfs，无挂载时序要求。
IVSBOX_APP=/opt/ivsbox
# 数据（config/db/queue/ota/secure/releases ＋ 熔断状态）：UDISK，由 S60mount_udisk
# 挂载，本脚本编号必须 > 60。
IVSBOX_HOME=/mnt/UDISK/ivsbox
# monitor.sh 的熔断状态文件（缺口清单 G8）在数据侧。restart 时清掉它 = 人工解除熔断。
MONITOR_STATE=$IVSBOX_HOME/.monitor.state
# 主控 pidfile 的写者只有 monitor（它是唯一拉起方）；本脚本 stop() 只读它。
PIDFILE=/var/run/ivsboxd.pid
MONITOR_PIDFILE=/var/run/ivsbox_monitor.pid

start() {
    echo -n "Starting ivsboxd: "

    # 预建程序目录（rootfs 内，无挂载时序要求）
    for d in bin scripts; do
        mkdir -p "$IVSBOX_APP/$d"
    done
    # 预建数据目录（UDISK 由 S60mount_udisk 挂载，本脚本编号必须 > 60）
    for d in config db queue ota secure releases; do
        mkdir -p "$IVSBOX_HOME/$d"
    done
    # 日志根目录与 iv_log 的默认 root 保持一致（/mnt/UDISK/log，见计划 §0）；
    # monitor.sh 的告警文件（monitor-alert.log）也落在这里。
    # 原写 `mkdir -p "$IVSBOX_HOME/log"` 与 iv_log 的实际落点不是同一个目录，
    # 属冗余且误导，2026-09-30 更正。
    mkdir -p /mnt/UDISK/log
    mkdir -p /var/run/ivsbox

    # 属主交给运行用户（当前未建 ivsbox 用户时默认 root）
    chown -R "$IVSBOX_USER:$IVSBOX_GROUP" "$IVSBOX_APP" "$IVSBOX_HOME" /var/run/ivsbox 2>/dev/null || true

    # 只拉起 monitor 守护循环，由它做主控的唯一拉起方（开机后至多晚一个轮询周期，
    # 默认 5 s）。**不在这里直接 start-stop-daemon 主控**：开机直启会绕过 monitor
    # 的 failsafe 熔断 —— 熔断期内每次复位后 init 都再送一次 ivsboxd 运行、每次
    # 都重新武装看门狗，"跨复位继续熔断"就不成立，持续的运行期崩溃循环会变成
    # 30 分钟一轮的整机复位风暴（2026-09-30 复核 F1）。
    /sbin/start-stop-daemon --start --background --make-pidfile \
        --pidfile "$MONITOR_PIDFILE" --exec "$IVSBOX_APP/scripts/monitor.sh" \
        --chuid "$IVSBOX_USER:$IVSBOX_GROUP" || {
        echo "FAIL"
        return 1
    }

    echo "OK"
}

stop() {
    echo -n "Stopping ivsboxd: "

    # 先停 monitor：monitor 每 5s 轮询一次，若先杀 ivsboxd，它会在轮询窗口里把主控
    # 重新拉起，造成"停不干净"。必须先把重启方干掉，再停主控。
    /sbin/start-stop-daemon --stop --pidfile "$MONITOR_PIDFILE" --signal TERM --retry 5 2>/dev/null || true

    # 再发 TERM，让 ivsboxd 走 iv_watchdog_disable() 正常停机，避免整机被复位
    /sbin/start-stop-daemon --stop --pidfile "$PIDFILE" --signal TERM --retry 20

    echo "OK"
}

restart() {
    # 人工解除 monitor.sh 的熔断（缺口清单 G8）：restart 是显式的人工动作，而开机
    # 流程（rcS）只会调 start、不会调 restart，所以在这里清熔断状态是安全的。
    # **不能放进 start()** —— 那样整机复位后 init 又会把计数清零，"跨复位的崩溃
    # 历史"就永远攒不起来，熔断等于没有。
    rm -f "$MONITOR_STATE"
    stop
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|force-reload)
        restart
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
