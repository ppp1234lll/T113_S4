#!/bin/sh
# IVSBox 主控服务 sysvinit 脚本（M1-S10）
# 不用 procd：板端没有 procd，用 start-stop-daemon 后台拉起。

IVSBOX_USER=${IVSBOX_USER:-root}
IVSBOX_GROUP=${IVSBOX_GROUP:-root}

IVSBOX_HOME=/mnt/UDISK/ivsbox
CURRENT=$IVSBOX_HOME/current
BIN=$CURRENT/bin/ivsboxd
# monitor.sh 的熔断状态文件（缺口清单 G8）。restart 时清掉它 = 人工解除熔断。
MONITOR_STATE=$IVSBOX_HOME/.monitor.state
PIDFILE=/var/run/ivsboxd.pid
MONITOR_PIDFILE=/var/run/ivsbox_monitor.pid

start() {
    echo -n "Starting ivsboxd: "

    # 预建运行目录（UDISK 由 S60mount_udisk 挂载，本脚本编号必须 > 60）
    for d in config db queue ota secure releases; do
        mkdir -p "$IVSBOX_HOME/$d"
    done
    # 日志根目录与 iv_log 的默认 root 保持一致（/mnt/UDISK/log，见计划 §0）；
    # monitor.sh 的告警文件（monitor-alert.log）也落在这里。
    # 原写 `mkdir -p "$IVSBOX_HOME/log"` 与 iv_log 的实际落点不是同一个目录，
    # 属冗余且误导，2026-09-30 更正。
    mkdir -p /mnt/UDISK/log
    mkdir -p /var/run/ivsbox

    # 属主交给运行用户（当前未建 ivsbox 用户时默认 root）
    chown -R "$IVSBOX_USER:$IVSBOX_GROUP" "$IVSBOX_HOME" /var/run/ivsbox 2>/dev/null || true

    # 拉起主控
    /sbin/start-stop-daemon --start --background --make-pidfile \
        --pidfile "$PIDFILE" --exec "$BIN" --chuid "$IVSBOX_USER:$IVSBOX_GROUP" || {
        echo "FAIL"
        return 1
    }

    # 同时拉起 monitor 守护循环（进程崩溃后自动重拉）
    /sbin/start-stop-daemon --start --background --make-pidfile \
        --pidfile "$MONITOR_PIDFILE" --exec "$CURRENT/scripts/monitor.sh" \
        --chuid "$IVSBOX_USER:$IVSBOX_GROUP" 2>/dev/null || true

    echo "OK"
}

stop() {
    echo -n "Stopping ivsboxd: "

    # 先停 monitor：monitor 每 5s 轮询一次，若先杀 ivsboxd，它会在轮询窗口里把主控
    # 重新拉起，造成"停不干净"。必须先把重启方干掉，再停主控。
    /sbin/start-stop-daemon --stop --pidfile "$MONITOR_PIDFILE" --signal TERM --retry 5 2>/dev/null || true

    # 再发 TERM，让 ivsboxd 走 iv_watchdog_disable() 正常停机，避免整机被复位
    /sbin/start-stop-daemon --stop --pidfile "$PIDFILE" --signal TERM --retry 20

    echo "OK"
}

restart() {
    # 人工解除 monitor.sh 的熔断（缺口清单 G8）：restart 是显式的人工动作，而开机
    # 流程（rcS）只会调 start、不会调 restart，所以在这里清熔断状态是安全的。
    # **不能放进 start()** —— 那样整机复位后 init 又会把计数清零，"跨复位的崩溃
    # 历史"就永远攒不起来，熔断等于没有。
    rm -f "$MONITOR_STATE"
    stop
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|force-reload)
        restart
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
