#!/bin/sh
# IVSBox Web 服务 sysvinit 脚本（M5-S5.1）
# 与 S65ivsboxd 同口径：不用 procd（板端无 procd），用 start-stop-daemon 后台拉起；
# **start() 只拉起 monitor-web.sh，ivsbox-web 由 monitor-web 唯一拉起**（跨复位熔断口径）。
#
# 编号 66 > 65：必须晚于 S65ivsboxd，让主控先建好本地通道 socket
# （/var/run/ivsbox/ctl）。即便晚了一步也没事 —— ivsbox-web 每次请求都重连通道，
# 通道不在时回 502，不阻塞也不退出。

IVSBOX_USER=${IVSBOX_USER:-root}
IVSBOX_GROUP=${IVSBOX_GROUP:-root}

# 程序（bin/scripts）落 rootfs；数据落 UDISK（S60mount_udisk 挂载，编号必须 > 60）。
IVSBOX_APP=/opt/ivsbox
IVSBOX_HOME=/mnt/UDISK/ivsbox
# monitor-web 的熔断状态文件在数据侧。restart 时清掉它 = 人工解除熔断。
MONITOR_STATE=$IVSBOX_HOME/.monitor-web.state
PIDFILE=/var/run/ivsbox-web.pid
MONITOR_PIDFILE=/var/run/ivsboxweb_monitor.pid
# 本地通道 socket 目录（与 ivsboxd 共用 /var/run/ivsbox）
RUN_DIR=/var/run/ivsbox

start() {
    echo -n "Starting ivsbox-web: "

    mkdir -p "$IVSBOX_APP/web/static"
    mkdir -p "$RUN_DIR" /mnt/UDISK/log

    chown -R "$IVSBOX_USER:$IVSBOX_GROUP" "$IVSBOX_APP" "$RUN_DIR" 2>/dev/null || true

    # 只拉起守护循环，由它拉起 / 看护 ivsbox-web。
    /sbin/start-stop-daemon --start --background --make-pidfile \
        --pidfile "$MONITOR_PIDFILE" --exec "$IVSBOX_APP/scripts/monitor-web.sh" \
        --chuid "$IVSBOX_USER:$IVSBOX_GROUP" || {
        echo "FAIL"
        return 1
    }

    echo "OK"
}

stop() {
    echo -n "Stopping ivsbox-web: "

    # 与 S65ivsboxd 同样的次序：先停守护方，再停被守护方。反过来的话，monitor-web 会在
    # 下个轮询窗口把刚停掉的进程重新拉起，"停不干净"。
    /sbin/start-stop-daemon --stop --pidfile "$MONITOR_PIDFILE" --signal TERM --retry 5 2>/dev/null || true
    # ivsbox-web 无看门狗，普通 TERM 即可正常退出。
    /sbin/start-stop-daemon --stop --pidfile "$PIDFILE" --signal TERM --retry 20 2>/dev/null || true

    echo "OK"
}

restart() {
    # 人工解除 monitor-web 的熔断：rcS 开机只调 start，故在 restart 清是安全的。
    rm -f "$MONITOR_STATE"
    stop
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|force-reload)
        restart
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
