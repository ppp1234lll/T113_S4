#include <windows.h>

#pragma code_page(65001)

/* 视觉样式 + 高 DPI + 不要求管理员 */
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "ivsbox"
            VALUE "FileDescription",  "运维箱通道配置"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "tunnelcfg"
            VALUE "OriginalFilename", "运维箱通道配置.exe"
            VALUE "ProductName",      "运维箱通道配置"
            VALUE "ProductVersion",   "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
